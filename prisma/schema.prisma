// ALBAZAR — Drop Machine schema (Phase 1)
// Prices stored EXCL. VAT, in halalas (integers). VAT 15% applied at display/checkout.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) for the app
  directUrl = env("DIRECT_URL") // direct/session pooler for migrations
}

enum DropStatus {
  TEASER // homepage = countdown
  LIVE // homepage = shop the drop
  SOLDOUT // pieces gone, pre-archive
  ARCHIVED // lives on /archive forever
}

enum OrderStatus {
  PENDING // checkout started, awaiting payment
  PAID // payment webhook confirmed
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PAID
  FAILED
  REFUNDED
}

enum Role {
  ADMIN
  EMPLOYEE
  CLIENT
}

model Drop {
  id          String     @id @default(cuid())
  nameAr      String
  nameEn      String
  slug        String     @unique
  status      DropStatus @default(TEASER)
  published   Boolean    @default(false) // draft until published; hidden publicly while false
  launchAt    DateTime
  teaserImage String?
  heroImage   String?
  sortOrder   Int        @default(0) // manual ordering of drops on the homepage
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameAr    String
  nameEn    String
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameEn    String
  nameAr    String?
  logo      String?
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  products  Product[]
  posts     Post[] // brand-spotlight journal articles
  createdAt DateTime  @default(now())
}

model Product {
  id          String           @id @default(cuid())
  dropId      String? // legacy/optional — catalogue is organised by brand + category
  drop        Drop?            @relation(fields: [dropId], references: [id], onDelete: SetNull)
  brandId     String?
  brand       Brand?           @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  nameAr      String
  nameEn      String
  storyAr     String?
  storyEn     String?
  price       Int // EXCL VAT, in halalas
  sku         String           @unique
  totalPieces Int
  images      String[]
  isActive    Boolean          @default(true)
  variants    ProductVariant[]
  orderItems  OrderItem[]
  wishlist    WishlistItem[]
  posts       Post[]           @relation("PostProducts") // featured in journal "shop the story"
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([dropId])
  @@index([categoryId])
  @@index([brandId])
}

model ProductVariant {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int             @default(0)
  holds     InventoryHold[]
  orderItems OrderItem[]

  @@unique([productId, size])
  @@index([productId])
}

model Order {
  id            String        @id @default(cuid())
  userId        String? // null for guest checkout
  user          User?         @relation(fields: [userId], references: [id])
  email         String?
  phone         String
  status        OrderStatus   @default(PENDING)
  subtotal      Int // excl VAT, halalas
  shippingCost  Int           @default(0)
  vatAmount     Int
  total         Int // incl VAT + shipping
  paymentId     String?
  paymentStatus PaymentStatus @default(INITIATED)
  paymentMethod String?
  addressJson   Json
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([paymentId])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String
  variant     ProductVariant  @relation(fields: [variantId], references: [id])
  quantity    Int
  unitPrice   Int // excl VAT, halalas
  pieceNumber Int? // assigned ONLY on confirmed payment webhook

  @@index([orderId])
}

model InventoryHold {
  id                String         @id @default(cuid())
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int
  expiresAt         DateTime
  checkoutSessionId String
  createdAt         DateTime       @default(now())

  @@index([checkoutSessionId])
  @@index([expiresAt])
}

model VaultMember {
  id            String   @id @default(cuid())
  phone         String   @unique
  email         String?
  whatsappOptIn Boolean  @default(true)
  source        String? // entrance | sellout | confirmation
  joinedAt      DateTime @default(now())
}

model User {
  id           String         @id @default(cuid())
  // Phone is the primary login identifier (required at registration); email is
  // now optional. Both unique-when-present (Postgres allows multiple NULLs).
  email         String?        @unique
  passwordHash String
  name         String?
  phone        String?        @unique
  role         Role           @default(CLIENT)
  addressJson  Json? // saved Saudi shipping address, autofills checkout
  vaultOptIn   Boolean        @default(false)
  orders       Order[]
  wishlist     WishlistItem[]
  cart         Cart?
  createdAt    DateTime       @default(now())
}

// Server-synced cart for logged-in users — gives admin visibility into
// members who have items in cart but never finished checkout.
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemsJson Json // CartLine[] snapshot from the client
  updatedAt DateTime @updatedAt
}

// Owner-controlled homepage hero slides (image + bilingual copy).
model HeroSlide {
  id         String   @id @default(cuid())
  image      String
  titleAr    String
  titleEn    String
  subtitleAr String?
  subtitleEn String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Setting {
  key   String @id
  value Json
}

// Short-lived email codes for account verification and password recovery.
// One active code per (email, purpose); hashed, 10-minute expiry.
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  purpose   String // EMAIL_VERIFY | PASSWORD_RESET
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

// First-party behaviour signal for personalised recommendations.
// anonId tracks logged-out visitors (cookie); merges to userId on login.
model Event {
  id        String   @id @default(cuid())
  userId    String?
  anonId    String?
  type      String // view | search | add_to_cart
  productId String?
  query     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([anonId])
  @@index([productId])
}

// Journal — bilingual brand-spotlight articles with a "shop the story" product
// strip. Drives SEO (brand long-tail queries) and links content -> products.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleAr     String
  titleEn     String
  excerptAr   String?
  excerptEn   String?
  bodyAr      String // article body (plain text / simple markdown)
  bodyEn      String
  coverImage  String?
  brandId     String? // the brand this spotlight features
  brand       Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  products    Product[] @relation("PostProducts") // shown in "shop the story"
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}
